      "reduced": {
        "expressive-scale": {
          "$type": "number",
          "$value": 1
        },
        "expressive-easing": {
          "$type": "cubicBezier",
          "$value": "{motion.reduced.easing}"
        },
        "decay": {
          "$type": "duration",
          "$value": "{motion.reduced.decay}"
        }
      }
