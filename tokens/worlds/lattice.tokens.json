          "$type": "cubicBezier",
          "$value": [
            0.3,
            0.85,
            0.1,
            1
          ],
          "$description": "Hard-damped: converges without a tail."
        },
        "decay": {
          "$type": "duration",
          "$value": {
            "value": 100,
            "unit": "ms"
          },
          "$description": "A brisk, exact release."
