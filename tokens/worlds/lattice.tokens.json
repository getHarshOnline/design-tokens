        "$type": "cubicBezier",
        "$value": [
          0.3,
          0.9,
          0.1,
          1
        ],
        "$description": "Hard-damped: resolves precisely and converges without a loose tail."
      },
      "decay": {
        "$type": "duration",
        "$value": {
          "value": 240,
          "unit": "ms"
