            "Saira",
            "Archivo",
            "Arial",
            "sans-serif"
          ],
          "$description": "Squared technical grotesk with a width axis: a specification voice.",
          "$extensions": {
            "design-tokens.delivery": "per target"
          }
        },
        "width": {
          "$type": "number",
          "$value": 92,
          "$description": "Slightly narrow and compact.",
          "$extensions": {
            "design-tokens.unit": "wdth"
          }
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 700
        }
      },
      "numeric": {
        "family": {
          "$type": "fontFamily",
          "$value": "{world.type.display.family}",
          "$description": "Figures in the display face, tabular lining, for specification pairs."
        }
      },
      "system": {
        "case": {
          "$type": "number",
          "$value": 1,
          "$description": "Capitals, as on a specification plate.",
          "$extensions": {
            "design-tokens.pattern": "uppercase"
          }
        }
      },
      "colophon": {
        "size": {
          "$type": "dimension",
          "$value": {
            "value": 72,
            "unit": "px"
          }
        }
