        "$extensions": {
          "design-tokens.unit": "deg"
        }
      },
      "emission": {
        "$type": "color",
        "$value": "{color.signal}",
        "$description": "Signal green, contained inside the module that holds state."
      },
      "emission-strength": {
        "$type": "number",
        "$value": "{illumination.emission.strength}"
      },
      "emission-spread": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$description": "None past the edge: light is clipped to the module that holds state."
      }
    },
