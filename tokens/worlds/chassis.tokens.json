        "edge": {
          "$type": "number",
          "$value": "{material.optical.edge}"
        },
        "highlight": {
          "$type": "number",
          "$value": "{elevation.film.highlight}"
        },
        "blur": {
          "$type": "dimension",
          "$value": "{material.optical.blur}"
        },
        "saturation": {
          "$type": "number",
          "$value": "{material.optical.saturation}"
        },
        "scene-fill": {
          "$type": "number",
          "$value": "{material.optical.fill}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{layout.film.card-radius}"
        }
      }
    },
    "geometry": {
      "$description": "Manufactured modules: square boundaries, stepped stacks, specification pairs.",
      "$extensions": {
        "design-tokens.pattern": "square-inset"
      },
      "plate-edge": {
        "$description": "The chassis edge: a square machined boundary with a hairline inset inside it; no corner cut.",
        "$extensions": {
          "design-tokens.pattern": "inset-hairline"
        },
        "size": {
          "$type": "dimension",
          "$value": {
            "value": 4,
            "unit": "px"
          },
          "$description": "Inset distance of the hairline."
        }
      }
    },
    "figure": {
      "scale-step": {
        "$type": "dimension",
        "$value": "{type.size.reading}",
        "$description": "Specification pairs, label left, value right."
      },
      "interval": {
        "$type": "dimension",
        "$value": "{space.6}"
      },
      "caption": {
        "$extensions": {
          "design-tokens.pattern": "row"
        },
        "gap": {
          "$type": "dimension",
          "$value": "{space.label}"
        }
      }
    },
    "crop": {
      "bleed": {
        "$type": "number",
        "$value": 2,
        "$description": "Named plates: Home's human and material encounter, product imagery and product plates; specifications never bleed.",
        "$extensions": {
          "design-tokens.pattern": "named-plates"
        }
      }
    },
    "depth": {
      "$description": "Interface modules use stepped planes with a clear front; authored working spaces have their own geography.",
      "planes": {
        "$type": "number",
        "$value": 3
      },
      "offset": {
        "$type": "dimension",
        "$value": "{space.2}"
      },
      "blur": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "motion": {
      "expressive-scale": {
        "$type": "number",
        "$value": 0.9,
        "$description": "Slightly quicker than neutral."
      },
      "expressive-easing": {
        "$type": "cubicBezier",
        "$value": [
          0.64,
          0,
          0.78,
          0
        ],
        "$description": "Latched: accelerates into place and locks, no overshoot."
      },
      "decay": {
        "$type": "duration",
        "$value": {
          "value": 90,
          "unit": "ms"
        },
        "$description": "Switches down to rest rather than fading."
      },
      "expressive-spring": {
        "$description": "Latched: a low bounce as it locks.",
        "visual-duration": {
          "$type": "number",
          "$value": 0.56,
          "$extensions": {
            "design-tokens.unit": "s"
          }
        },
        "bounce": {
          "$type": "number",
          "$value": 0.1
        }
      },
      "reduced": {
        "expressive-scale": {
          "$type": "number",
          "$value": 0.5,
          "$description": "A short switch of state in place."
        },
        "expressive-easing": {
          "$type": "cubicBezier",
          "$value": [
            0.64,
            0,
            0.78,
            1
          ],
          "$description": "Latched: the light switches and locks."
        },
        "decay": {
          "$type": "duration",
          "$value": "{world.motion.decay}",
          "$description": "Already a switch without travel: the world's own decay."
        }
      }
    },
    "mode": {
      "default": {
        "$extensions": {
          "design-tokens.pattern": "system"
        }
      }
    }
