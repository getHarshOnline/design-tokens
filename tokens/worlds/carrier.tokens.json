        },
        "expressive-easing": {
          "$type": "cubicBezier",
          "$value": [
            0.25,
            0.5,
            0.3,
            1
          ],
          "$description": "Damped: the light resolves with no scatter."
        },
        "decay": {
          "$type": "duration",
          "$value": "{motion.reduced.decay}",
