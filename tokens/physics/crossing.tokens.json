          "hex": "#93cfd0"
        }
      }
    },
    "lattice": {
      "$extensions": {
        "design-tokens.mark": "⌑",
        "design-tokens.mask": {
          "image": "linear-gradient(to right,#000 0% 12%,transparent 12% 88%,#000 88%),linear-gradient(to right,#000 0% 35%,transparent 35% 65%,#000 65%),linear-gradient(to right,#000 0% 35%,transparent 35% 65%,#000 65%)",
          "size": "var(--space-3) var(--space-3),var(--space-3) var(--stroke-hair),var(--space-3) var(--stroke-hair)",
          "position": "right center,right calc(50% - var(--space-3) / 2),right calc(50% + var(--space-3) / 2)",
          "composite": "add"
        }
      },
      "light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2, 0.3686, 0.5569],
