          "components": [0.6431, 0.7882, 0.9059],
          "hex": "#a4c9e7"
        }
      }
    },
    "nocturne": {
      "$extensions": {
        "design-tokens.mark": "◐",
        "design-tokens.mask": {
          "image": "radial-gradient(circle at 75% 30%,transparent 0% 48%,#000 50%),radial-gradient(circle,#000 0% 60%,transparent 62%)",
          "size": "var(--space-3) var(--space-3)",
          "position": "right center",
          "composite": "intersect"
        }
      },
      "light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4745, 0.3529, 0.5804],
          "hex": "#795a94"
        }
      },
      "dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7647, 0.6431, 0.8431],
          "hex": "#c3a4d7"
        }
      }
    }
  }
}
