{
  "$description": "Cross-world target signatures. A crossing link carries its target world's signature (underline colour and bounded mark), so every world's stylesheet needs every signature. Mode-bound through color.crossing.<world>. Each mask supplies geometry independently of ink; the source glyph names the visual idea and is not a font requirement.",
  "crossing": {
    "carrier": {
      "$extensions": {
        "design-tokens.mark": "≡",
        "design-tokens.mask": {
          "image": "linear-gradient(to bottom,#000 0% 12%,transparent 12% 44%,#000 44% 56%,transparent 56% 88%,#000 88%)",
          "size": "var(--space-3) var(--space-3)",
          "position": "right center",
          "composite": "add"
        }
      },
      "light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6078, 0.2078, 0.251],
          "hex": "#9b3540"
        }
      },
      "dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.6275, 0.6549],
          "hex": "#eba0a7"
        }
      }
    },
    "chassis": {
      "$extensions": {
        "design-tokens.mark": "▣",
        "design-tokens.mask": {
          "image": "linear-gradient(to right,#000 0% 12%,transparent 12% 88%,#000 88%),linear-gradient(to bottom,#000 0% 12%,transparent 12% 88%,#000 88%),linear-gradient(#000,#000)",
          "size": "var(--space-3) var(--space-3),var(--space-3) var(--space-3),var(--space-1) var(--space-1)",
          "position": "right center,right center,right calc((var(--space-3) - var(--space-1)) / 2) center",
          "composite": "add"
        }
      },
      "light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1961, 0.4392, 0.3255],
          "hex": "#327053"
        }
      },
      "dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6078, 0.8157, 0.6745],
          "hex": "#9bd0ac"
        }
      }
    },
    "chronicle": {
      "$extensions": {
        "design-tokens.mark": "⫯",
        "design-tokens.mask": {
          "image": "linear-gradient(#000,#000),radial-gradient(circle,#000 0% 48%,transparent 50%)",
          "size": "var(--stroke-hair) var(--space-3),var(--space-2) var(--space-2)",
          "position": "right calc(var(--space-3) / 2) center,right calc((var(--space-3) - var(--space-2)) / 2) center",
          "composite": "add"
        }
      },
      "light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5922, 0.3098, 0.1059],
          "hex": "#974f1b"
        }
      },
      "dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9216, 0.6392, 0.4157],
          "hex": "#eba36a"
        }
      }
    },
    "folio": {
      "$extensions": {
        "design-tokens.mark": "║",
        "design-tokens.mask": {
          "image": "linear-gradient(to right,transparent 0% 25%,#000 25% 37%,transparent 37% 63%,#000 63% 75%,transparent 75%)",
          "size": "var(--space-3) var(--space-3)",
          "position": "right center",
          "composite": "add"
        }
      },
      "light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1922, 0.4235, 0.4118],
          "hex": "#316c69"
